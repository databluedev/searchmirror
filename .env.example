# SearchMirror — LOCAL DEVELOPMENT configuration.
#
# Copy to .env before the first `docker compose up`:
#     cp .env.example .env
#
# .env is gitignored. NEVER put a real credential in THIS file — it is committed.
# Every value below is either a safe local default or intentionally blank.
#
# ┌──────────────────────────────────────────────────────────────────────────┐
# │ THIS FILE IS NOT A PRODUCTION TEMPLATE.                                  │
# │                                                                          │
# │ It deliberately turns on things production must not have: DJANGO_DEBUG,  │
# │ a placeholder secret key, and a MongoDB password published in this very  │
# │ repository. They are here so `cp .env.example .env && docker compose up` │
# │ gives you a working stack in one step, and they are safe only because    │
# │ the compose file publishes the database on loopback and you are the only │
# │ one who can reach it.                                                    │
# │                                                                          │
# │ Deploying anywhere else: start from .env.production.example instead, and │
# │ follow docs/DEPLOYMENT.md.                                               │
# └──────────────────────────────────────────────────────────────────────────┘


# ─── MongoDB ──────────────────────────────────────────────────────────────────
# The compose file starts mongo:4.4 and creates this root user on first boot.
# These only ever describe the local container — never a production cluster.
# The password below is public (it is in this committed file), which is why
# docker-compose.yml publishes the port on 127.0.0.1 only and the production
# overlay does not publish it at all.
# Changing MONGO_USER/MONGO_PASSWORD after the volume exists has no effect;
# run `docker compose down -v` to re-initialise.
MONGO_USER=tracker
MONGO_PASSWORD=trackerlocal
MONGO_DB=tracker
MONGO_HOST=mongo
MONGO_PORT=27017
# The root user is created in the `admin` database, so authSource must point
# there rather than at MONGO_DB.
MONGO_AUTH_SOURCE=admin
# Full connection string. When set it wins over the six values above; both
# Django apps prefer it. Keep the two in sync or leave this blank.
MONGO_URI=mongodb://tracker:trackerlocal@mongo:27017/tracker?authSource=admin
# How long (seconds) a database connection is reused across requests.
# Leaving this at Django's default of 0 costs a flat ~500ms on EVERY
# authenticated request: djongo caches one MongoClient per database and closes
# it at the end of each request, so the next request reopens a dead client and
# waits out pymongo's 0.5s topology rescan floor. Set to 0 to restore that
# behaviour if a connection-reuse problem ever needs ruling out.
DB_CONN_MAX_AGE=600


# ─── Django ───────────────────────────────────────────────────────────────────
# DEBUG is on for local work. Setting it also makes backend/tracker/settings.py
# re-raise import errors instead of swallowing them into logs/app.log.
#
# It also serves tracebacks — with settings, environment and SQL — to whoever
# asks. Turn it off and settings.py will refuse to start until you have
# replaced the placeholder key below, which is the intended order of events.
DJANGO_DEBUG=True
# Generate your own for anything long-lived:
#     python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=local-dev-only-not-a-real-secret
# Comma-separated; `localhost` and `127.0.0.1` are always allowed on top of
# this list. `backend` is here because the engine container calls the API by
# its compose-network name (http://backend:8000) — drop it and engine-driven
# competitor analysis starts returning 400 DisallowedHost.
#
# This used to be `*`, which answers to any Host header. Nothing local needs
# that, and `*` in a file people copy verbatim is how it reaches production.
# Reaching the stack from another machine on your LAN? Add that hostname here.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Public browser and API origins used in links generated by the backend.
APP_SITE_URL=http://127.0.0.1:3001
APP_API_URL=http://127.0.0.1:8000


# ─── SERP provider — BYOK ─────────────────────────────────────────────────────
# SearchMirror is bring-your-own-key: each account stores its own DataBlue key,
# entered in the UI under Account → SERP key. The raw key is validated against
# the provider, then encrypted at rest with the master secret below.
#
# Generate a real one before storing any key:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Rotating this value makes every already-stored account key unreadable —
# every user must re-enter theirs. Treat it as permanent.
SERP_KEY_SECRET=change-me-generate-with-python-secrets-token-urlsafe-48

# Instance-wide key, used by the engine when an account has no readable key of
# its own AND ALLOW_INSTANCE_FALLBACK is on. Get a key at https://datablue.dev
DATABLUE_API_KEY=

# Whether a rank check with no per-account key may spend DATABLUE_API_KEY.
#   true  — a single-operator self-host: everything runs on the key above.
#   false — hosted/multi-user: an account with no readable key gets NO ranking
#           instead of quietly spending yours. Nothing on screen would have
#           looked wrong, which is exactly why this is a switch and not a
#           silent default.
ALLOW_INSTANCE_FALLBACK=false


# ─── Operational email ────────────────────────────────────────────────────────
# Comma-separated recipient lists. Blank disables the alert entirely: the code
# filters empty entries out, so no mail is attempted.

# Engine watchdog failures (backend/glassend/watchmail.py).
EMERGENCY_MAIL=

# ─── Django admin ─────────────────────────────────────────────────────────────
# The admin at /serministrator/ gives full cross-tenant model access and is not
# part of the product -- nothing in the app links to it. It is routed only when
# DJANGO_DEBUG=True, or when this is explicitly 'true'. An obfuscated URL is not
# a security control; leave this blank unless you actively need the admin.
ENABLE_DJANGO_ADMIN=


# ─── Local seed data ──────────────────────────────────────────────────────────
# backend/scripts/seed_local.py runs on backend boot and is idempotent. These
# override what it creates.
#
# The credentials below are PUBLIC -- they are in this file, the README and
# CLAUDE.md. The seed therefore refuses to run unless DJANGO_DEBUG=True, or
# SEED_LOCAL is explicitly 'true'. Without that gate, every deployment of the
# shipped compose file would boot an internet-reachable account whose password
# is published in its own documentation. Leave this blank in production.
SEED_LOCAL=
SEED_EMAIL=admin@local.test
SEED_PASSWORD=LocalDev12345
# A domain that genuinely ranks for the seeded terms, so the demo shows real
# positions instead of a column of zeroes.
SEED_DOMAIN=semrush.com


# ─── AI providers (optional) ──────────────────────────────────────────────────
# Optional instance keys for single-operator installs. Hosted/multi-user
# installs should leave these blank and let each account save its own key under
# Settings -> AI Keys. Geo Citations and Content Planner share these providers.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=
GEMINI_API_KEY=


# ─── Outbound email (optional) ────────────────────────────────────────────────
# Blank disables transactional mail entirely — signup verification and report
# delivery simply do not send. Nothing else breaks.
EMAIL_HOST=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Envelope sender, and comma-separated admin recipients.
HOST_MAIL=SearchMirror <noreply@localhost>
ADMIN_MAIL=


# ─── Google Search Console (optional, frontend build-time) ────────────────────
# Register your own OAuth client at https://console.cloud.google.com.
# A client secret in browser code is public to anyone who loads the page — the
# token exchange belongs on the server. Treat this as unfinished, not as a
# supported integration.
#   app/ is Vite      -> VITE_*
#   client-app/ is CRA -> REACT_APP_*
VITE_GSC_CLIENT_ID=
VITE_GSC_SECRET=
REACT_APP_GSC_CLIENT_ID=
REACT_APP_GSC_SECRET=


# ─── Scheduler ────────────────────────────────────────────────────────────────
# DAILY RANK TRACKING NEEDS NOTHING HERE. The compose stack ships a `scheduler`
# container that runs `manage.py rank_schedule` every 15 minutes, so projects
# rank in the 01:00 hour on their own. A local process needs no shared secret.
#
# CRON_TOKEN is only for driving the scheduled endpoints over HTTP from your
# own cron instead -- they are public URLs that spend provider credits, so they
# are gated on this secret, sent as an X-Cron-Token header:
#
#     */15 * * * *  curl -H "X-Cron-Token: $CRON_TOKEN" https://your-host/rank/schedule
#     0    * * * *  curl -H "X-Cron-Token: $CRON_TOKEN" https://your-host/llmtracker/manage
#
# If you do that, stop the bundled scheduler so the two do not both queue:
# `docker compose stop scheduler`.
#
# /rank/schedule is DAILY RANK TRACKING -- the product's core loop. It gives
# each project a run time spread across the day, queues the ones that are due,
# and asks the engine to rank them. Every step is idempotent, so calling it
# every 15 minutes is correct and calling it twice costs nothing extra.
#
# WITHOUT IT NOTHING EVER RE-RANKS. Rank checks then only happen when someone
# clicks Refresh. The graph goes flat and no error is shown anywhere, because
# from the app's point of view nothing failed -- nothing was asked for. If you
# take one thing from this file: an instance with a blank CRON_TOKEN is not
# tracking rankings.
#
# /llmtracker/manage is the Geo Citations scheduler and spends account AI keys.
#
# Leave it BLANK and both endpoints refuse everyone with 503 -- which is the
# right default, because the alternative is an anonymous URL that bills you.
# Setting it is a deliberate act: the first run after you do will spend one
# DataBlue request per keyword per page of depth, on every due project.
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
CRON_TOKEN=


# ─── Browser origins ──────────────────────────────────────────────────────────
# Which front-end origins may call this API. Comma-separated, each with its
# scheme. The default covers a local docker run; set it to your own hostnames
# in production. This used to be CORS_ORIGIN_ALLOW_ALL=True -- any site on the
# internet could call the API. Tokens ride in the Authorization header rather
# than a cookie, so a hostile page could not forge an authenticated request,
# but answering every origin is not a default worth publishing.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:8000

# Escape hatch for debugging only. true re-opens the API to every origin.
CORS_ALLOW_ALL=

# --- Engine -----------------------------------------------------------------
# The engine is an internal service: the backend reaches it over the compose
# network and ranking is driven by `docker compose exec engine python
# rank_local.py`. These only matter if you drive its HTTP automation endpoints.

# Signing key for the engine's Django instance. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
ENGINE_SECRET_KEY=

# Keep true only for local development. Production defaults to false.
ENGINE_DEBUG=True

# Hosts the engine will answer to.
ENGINE_ALLOWED_HOSTS=localhost,127.0.0.1,engine

# Callers permitted to drive the automation endpoints. A sibling container
# arrives as its compose-network address (172.x), not 127.0.0.1.
ENGINE_ALLOWED_IPS=127.0.0.1

# On-demand engine trigger. When set, clicking Refresh (or starting a
# competitor analysis) has the backend ask the ranking engine to process the
# queued work immediately, over the private compose network -- so a
# self-hosted instance does not need a cron to make Refresh actually rank.
# Both the backend and engine read it; leave blank to disable on-demand runs.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ENGINE_TRIGGER_TOKEN=

# Engine claim/retry tuning. The defaults are correct for a single-worker
# install; you only need these if runs are slow or you run more than one
# engine worker.
#
# How long a claim on a project or keyword is trusted before the engine
# assumes the worker holding it died and takes the work back. Must be longer
# than your slowest ranking run, or claims get stolen mid-flight.
ENGINE_STALE_CLAIM_MINUTES=30
# How many refreshes one account may have running at once. The instance-wide
# ceiling is separate; this is what stops one account's queue starving
# everyone else's.
ENGINE_TENANT_WAIT_CAP=1
# How many times a keyword may fail before it is recorded as unmeasurable for
# the day, and the first backoff between attempts (it doubles). Every attempt
# is billed to the account's own SERP key, so keep the cap low.
ENGINE_KEYWORD_ATTEMPT_CAP=3
ENGINE_KEYWORD_BACKOFF_MINUTES=15

# --- AI model overrides (Geo Citations and Content Planner) -----------------
# Provider model names drift; pin current ones without a code change. Defaults
# are set in llmtracker/views.py. Google retired gemini-1.5-flash and
# gemini-2.0-flash, so the default is gemini-3.6-flash.
GEMINI_MODEL=
OPENAI_MODEL=
ANTHROPIC_MODEL=
PERPLEXITY_MODEL=
