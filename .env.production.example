# SearchMirror — PRODUCTION configuration template.
#
# Copy to .env on the server, fill in every value marked REQUIRED, then start
# the stack with the production overlay:
#
#     cp .env.production.example .env
#     $EDITOR .env
#     docker compose -f docker-compose.yml -f docker-compose.prod.yml \
#                    --profile prod up -d --build
#
# docs/DEPLOYMENT.md is the ordered checklist around this file — TLS, backups,
# log rotation and the EOL runtimes are not things an env file can fix.
#
# .env is gitignored. This template is committed, so it contains no secrets:
# every REQUIRED value below is blank and the stack refuses to start without
# it, which is deliberate. A production deployment that boots on defaults is
# a production deployment running someone else's published credentials.


# ─── MongoDB ──────────────────────────────────────────────────────────────────
# REQUIRED. The compose file creates this root user on the volume's first boot
# and it cannot be changed afterwards without re-initialising the volume, so
# set it before the first `up`.
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
MONGO_USER=tracker
MONGO_PASSWORD=
MONGO_DB=tracker
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_AUTH_SOURCE=admin
# REQUIRED, and must agree with the six values above — both Django apps prefer
# this string when it is set.
#     mongodb://<user>:<password>@mongo:27017/tracker?authSource=admin
MONGO_URI=

# How long (seconds) a database connection is reused across requests. Leaving
# this at Django's default of 0 costs a flat ~500ms on EVERY authenticated
# request — djongo caches one MongoClient per database and closes it at the end
# of each request, so the next request reopens a dead client and waits out
# pymongo's 0.5s topology rescan floor. At 3 workers that is a ~6 req/s ceiling
# for the whole instance. Set to 0 only to rule out a connection-reuse problem.
DB_CONN_MAX_AGE=600

# Using a managed cluster instead of the bundled mongo:4.4 container? Point
# MONGO_URI at it, drop the `mongo` service, and remove the `depends_on:
# mongo` blocks. Read the version note in docs/DEPLOYMENT.md first: djongo
# 1.3.6 does not support MongoDB 5+.


# ─── Django ───────────────────────────────────────────────────────────────────
# Blank means False. DEBUG serves full tracebacks — settings, environment,
# query values — to anyone who triggers an error. It also switches on the
# Django admin and the local seed. Leave it blank.
DJANGO_DEBUG=

# REQUIRED. Sessions, password-reset links and every signed value depend on
# this. settings.py refuses to start with DEBUG off and a placeholder here.
#     python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# REQUIRED. Comma-separated; every hostname this API answers on. `localhost`
# and `127.0.0.1` are always appended, and `backend` must stay in the list
# because the engine container calls the API by its compose-network name.
# Never `*` here.
DJANGO_ALLOWED_HOSTS=backend,api.example.com

# REQUIRED. Public origins, used in report links and verification emails.
# https:// — see the TLS section of docs/DEPLOYMENT.md.
# APP_API_URL is also compiled into the frontend bundle at image build time,
# so changing it means rebuilding app-prod, not restarting it.
APP_SITE_URL=https://example.com
APP_API_URL=https://api.example.com


# ─── SERP provider — BYOK ─────────────────────────────────────────────────────
# REQUIRED. Master secret that encrypts every account's stored DataBlue key.
# Rotating it makes all stored keys unreadable and every user must re-enter
# theirs — treat it as permanent, and include it in your backups.
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
SERP_KEY_SECRET=

# Instance-wide key. Only used when an account has no readable key of its own
# AND ALLOW_INSTANCE_FALLBACK is true. Get one at https://datablue.dev
DATABLUE_API_KEY=

# false on any instance with users other than you: an account with no key gets
# no ranking, instead of quietly spending yours.
ALLOW_INSTANCE_FALLBACK=false


# ─── Django admin ─────────────────────────────────────────────────────────────
# Full cross-tenant model access, and nothing in the product links to it.
# Leave blank. If you do enable it, note that gunicorn does not serve static
# files — run `manage.py collectstatic` and map /static/ in your reverse proxy
# or the admin arrives unstyled.
ENABLE_DJANGO_ADMIN=

# ─── Local seed data ──────────────────────────────────────────────────────────
# Leave blank. The seed creates an account whose password is published in this
# repository's README.
SEED_LOCAL=


# ─── Operational email ────────────────────────────────────────────────────────
# Engine watchdog failures. Comma-separated; blank sends nothing.
EMERGENCY_MAIL=


# ─── AI providers (optional) ──────────────────────────────────────────────────
# Instance-wide keys for a single-operator install. On a multi-user instance
# leave these blank and let each account save its own under Settings → AI Keys,
# otherwise every user's Geo Citations run bills you.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=
GEMINI_API_KEY=


# ─── Outbound email ───────────────────────────────────────────────────────────
# Blank disables transactional mail: signup verification and report delivery
# silently do not send. On a multi-user instance that is a broken signup flow,
# so configure it.
EMAIL_HOST=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
HOST_MAIL=SearchMirror <noreply@example.com>
ADMIN_MAIL=


# ─── Scheduler ────────────────────────────────────────────────────────────────
# REQUIRED if you want the Geo Citations scheduler to run. Its management
# endpoint has no browser session, so it is gated on this shared secret sent
# as X-Cron-Token. Blank means the endpoint refuses everyone with 503, which
# is the right default — the alternative is an anonymous URL that bills you.
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
CRON_TOKEN=


# ─── Browser origins ──────────────────────────────────────────────────────────
# REQUIRED. Which front-end origins may call this API — your own hostnames,
# each with its scheme. Not localhost.
CORS_ALLOWED_ORIGINS=https://example.com

# Leave blank. `true` re-opens the API to every origin on the internet.
CORS_ALLOW_ALL=


# ─── Engine ───────────────────────────────────────────────────────────────────
# REQUIRED. Signing key for the engine's own Django instance; it refuses to
# start with DEBUG off and the committed development key.
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
ENGINE_SECRET_KEY=

# Blank means False. Keep it blank.
ENGINE_DEBUG=

# The engine is never published publicly, so this list stays internal.
ENGINE_ALLOWED_HOSTS=localhost,127.0.0.1,engine

# Callers permitted to drive the automation endpoints. A sibling container
# arrives as its compose-network address (172.x), not 127.0.0.1.
ENGINE_ALLOWED_IPS=127.0.0.1

# REQUIRED for the Refresh button to actually rank on demand: the backend uses
# it to ask the engine to process queued work immediately over the private
# compose network. Blank disables on-demand runs.
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
ENGINE_TRIGGER_TOKEN=


# ─── Gunicorn ─────────────────────────────────────────────────────────────────
# The overlay runs gunicorn's THREADED worker class. Concurrency is
# WORKERS x THREADS: processes give you parallel CPU and crash isolation,
# threads give you parallel waiting.
#
# Threads here buy AVAILABILITY, not throughput. A sync pool of N serves
# exactly N requests at once and the N+1th waits at the socket -- so one PDF
# export or one provider call consumes a whole slot of three. Measured, this
# API's requests are CPU-bound (2.2 of 4 cores busy at 8 concurrent), so
# threads cost about 13% throughput on an idle server and repay it as soon as
# something slow is in flight. Raise GUNICORN_WORKERS toward 2 x cores + 1 if
# you want raw throughput; that is what scales CPU-bound work.
GUNICORN_WORKERS=3
GUNICORN_THREADS=4
# The engine is the one place the I/O argument holds outright: its threads wait
# on DataBlue for minutes at a time. Fewer processes, more threads.
ENGINE_WORKERS=2
ENGINE_THREADS=8

# Mongo connection ceiling per PROCESS. Django allocates one connection per
# thread, and DB_CONN_MAX_AGE keeps them open, so a process holds at most
# GUNICORN_THREADS (or ENGINE_THREADS) connections at once. This must exceed
# the larger of the two, with headroom for the engine's own mongoengine
# connection and for admin sessions:
#     max(GUNICORN_THREADS, ENGINE_THREADS) = 8  ->  100 is ample headroom
# Raise it if you raise the thread counts; the server also has its own global
# connection limit, which is what you would hit next.
MONGO_MAX_POOL_SIZE=100


# ─── AI model overrides (optional) ────────────────────────────────────────────
# Provider model names drift; pin current ones without a code change.
GEMINI_MODEL=
OPENAI_MODEL=
ANTHROPIC_MODEL=
PERPLEXITY_MODEL=
