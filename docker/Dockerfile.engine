# Tracker engine — its own requirements, separate from the Django app.
FROM python:3.9-slim

ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1

# Build tools cover the few legacy packages without a wheel; the engine no
# longer carries PDF, browser, S3, or local-ML runtimes.
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential gcc curl netcat-openbsd \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements-prod.txt /tmp/requirements.txt

# pkg_resources==0.0.0 is a Debian pip-freeze artifact, not a real package.
# setuptools<58 — djongo 1.3.6 still uses `use_2to3`, removed in newer setuptools.
RUN sed -i '/pkg.resources==0.0.0/d' /tmp/requirements.txt \
 && pip install --no-cache-dir "pip<24" "setuptools<58" wheel \
 && pip install --no-cache-dir --timeout 180 --retries 10 -r /tmp/requirements.txt

EXPOSE 8001

# An unprivileged user for the application process -- same reasoning and same
# mechanism as Dockerfile.django: ./engine is bind-mounted over /app, so uid 0
# here is write access to the host source tree, and the privilege drop happens
# in the compose command (`setpriv --reuid=app`) because logs/ and
# project/files/ only exist once the mount is in place.
#
# Override APP_UID/APP_GID if the host account owning the checkout is not 1000:
#     docker compose build --build-arg APP_UID=$(id -u) --build-arg APP_GID=$(id -g) engine
ARG APP_UID=1000
ARG APP_GID=1000
RUN groupadd --gid ${APP_GID} app \
 && useradd --uid ${APP_UID} --gid ${APP_GID} --create-home --shell /bin/sh app \
 && chown app:app /app
