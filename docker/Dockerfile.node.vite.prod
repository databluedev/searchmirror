# Production build of the Vite frontend. Stage one compiles, stage two serves
# the static output with nginx -- the same shape as Dockerfile.node.prod, but
# Vite's toolchain and output layout.
#
# Context is the repo root so this can share docker/nginx.frontend.vite.conf.
FROM node:20-bookworm-slim AS build

WORKDIR /build

COPY app/package.json app/package-lock.json ./
RUN npm ci --legacy-peer-deps --no-audit --no-fund

COPY app/ ./

# Vite inlines VITE_* at compile time, so the API host is fixed when the image
# is built, not when the container starts. Same trade-off CRA had with
# REACT_APP_*; the variable is renamed because only VITE_-prefixed names reach
# import.meta.env.
ARG VITE_API_URL=http://127.0.0.1:8000
ENV VITE_API_URL=$VITE_API_URL


RUN npm run build


FROM nginx:1.27-alpine AS serve
COPY --from=build /build/build /usr/share/nginx/html
COPY docker/nginx.frontend.vite.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
