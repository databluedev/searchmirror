# Tracker backend — Python 3.9.23, Django 3.2.25, djongo 1.3.6.
FROM python:3.9-slim

ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1

# Native libs pip cannot provide: cairo/pango for WeasyPrint (PDF reports),
# libmagic for python-magic, libxml2/xslt for lxml.
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential gcc curl netcat-openbsd \
        libcairo2 libpango-1.0-0 libpangocairo-1.0-0 libgdk-pixbuf-2.0-0 \
        libffi-dev shared-mime-info fonts-dejavu-core \
        libmagic1 libjpeg62-turbo zlib1g libxml2 libxslt1.1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements-prod.txt /tmp/requirements.txt

# pkg_resources==0.0.0 is a Debian pip-freeze artifact, not a real package.
# setuptools<58 — djongo 1.3.6 still uses `use_2to3`, removed in newer setuptools.
RUN sed -i '/pkg.resources==0.0.0/d' /tmp/requirements.txt \
 && pip install --no-cache-dir "pip<24" "setuptools<58" wheel \
 && pip install --no-cache-dir --timeout 180 --retries 10 -r /tmp/requirements.txt

EXPOSE 8000

# An unprivileged user for the application process. The repository is
# bind-mounted over /app, so anything running as uid 0 in this container can
# write as root across the host source tree.
#
# The image deliberately does NOT end with `USER app`. logs/ and files/ live
# inside the bind mount, which does not exist at build time, and they arrive
# owned by root from every earlier root-run of this stack -- so nothing at
# build time can make them writable. Instead the compose command starts as
# root, creates and chowns exactly those two directories, and then hands the
# process over with `setpriv --reuid=app`. Everything from `migrate` onward,
# including the server itself, runs as this user; `docker compose exec backend
# ps -o user,args` is how you check.
#
# 1000:1000 is the first non-system id on a Linux desktop, which is what the
# checkout is normally owned by. If your host account differs, build with it,
# or the chown will take your own files away from you:
#     docker compose build --build-arg APP_UID=$(id -u) --build-arg APP_GID=$(id -g) backend
ARG APP_UID=1000
ARG APP_GID=1000
RUN groupadd --gid ${APP_GID} app \
 && useradd --uid ${APP_UID} --gid ${APP_GID} --create-home --shell /bin/sh app \
 && chown app:app /app
